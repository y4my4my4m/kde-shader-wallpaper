// ------------------------------------------------------------- state

vec4 st(int k) { return texelFetch(iChannel0, ivec2(k, 0), 0); }

// Buffer A's grid keeps the screen's aspect unless its width is clamped to
// 64 texels (narrow portrait screens at small simulation heights); state x is
// in grid H units, and gK scales it to this pass's H units.
float gK = 1.0;
float gGridA = 1.0;
vec4 stp(int k)
{
    vec4 v = st(k);
    return vec4(v.x * gK, v.y, v.z * gK, v.w);
}

int gEye;   // eye glyph of the frame being drawn

// ------------------------------------------------------------- sprites

int catPix(int f, ivec2 q)
{
    if (q.x < 0 || q.x > 31 || q.y < 0 || q.y > 31) return 0;
    ivec4 e = CAT_EYES[f];
    for (int k = 0; k < 2; k++) {
        ivec2 a = k == 0 ? e.xy : e.zw;
        if (a.x < 0) continue;
        ivec2 d = q - a + ivec2(1, 0);
        if (d.x >= 0 && d.x < 4 && d.y >= 0 && d.y < 3) {
            int g = int((GLYPH[gEye * 3 + d.y] >> uint(d.x * 4)) & 15u);
            if (g != 0) return g;
        }
    }
    ivec2 m = CAT_META[f];
    if (q.y < m.y) return 0;
    uint w = CAT[m.x + (q.y - m.y) * 4 + (q.x >> 3)];
    return int((w >> uint((q.x & 7) * 4)) & 15u);
}

int propPix(int k, ivec2 q)
{
    ivec4 m = PROP_META[k];
    if (q.x < 0 || q.y < 0 || q.x >= m.y || q.y >= m.z) return 0;
    uint w = PROP[m.x + q.y * m.w + (q.x >> 3)];
    return int((w >> uint((q.x & 7) * 4)) & 15u);
}

vec3 coatColour(int i, int x)
{
    int c = clamp(COAT, 0, 4);
    if (i == 12) {
        if (!COLLAR) i = (x >= 13 && x <= 18) ? 4 : 2;
        else return COLLAR_COLOUR;
    }
    if (i == 13 && !COLLAR) i = 4;
    return COATS[c * 16 + i];
}

// Draws prop k with its bottom centre at screen pixel b (rows top first);
// rot turns it about its centre. Returns palette index, 0 = none.
int propAt(int k, vec2 fc, vec2 b, float ps, float rot, bool flip)
{
    ivec4 m = PROP_META[k];
    vec2 l = (fc - b) / ps + vec2(0.5 * float(m.y), 0.0);
    if (rot != 0.0) {
        vec2 c = vec2(0.5 * float(m.y), 0.5 * float(m.z));
        float cs = cos(rot);
        float sn = sin(rot);
        vec2 r = l - c;
        l = c + vec2(cs * r.x + sn * r.y, -sn * r.x + cs * r.y);
    }
    ivec2 q = ivec2(floor(l));
    if (flip) q.x = m.y - 1 - q.x;
    return propPix(k, ivec2(q.x, m.z - 1 - q.y));
}

// ------------------------------------------------------------- the room

vec3 coverImage(vec2 fc)
{
    vec2 uv = fc / iResolution.xy;
    vec2 texRes = iChannelResolution[1].xy;
    float sa = iResolution.x / iResolution.y;
    float ta = texRes.x / texRes.y;
    vec2 fit = sa > ta ? vec2(1.0, ta / sa) : vec2(sa / ta, 1.0);
    return texture(iChannel1, clamp((uv - 0.5) * fit + 0.5, 0.0, 1.0)).rgb;
}

// Wall, skirting board and floorboards, in sprite pixels v (screen px / ps).
vec3 room(vec2 fc, float ps)
{
    vec2 v = floor(fc / ps);
    float y = fc.y / iResolution.y;
    float yJ = FLOOR_Y + 0.030;           // wall meets floor
    float yS = yJ + 0.026;                // skirting top
    vec2 uv = fc / iResolution.xy;
    if (y > yS) {
        vec3 c = WALL_COLOUR;
        // Faint half-drop motif of small diamonds.
        vec2 cell = vec2(22.0, 22.0);
        vec2 g = v;
        g.x += mod(floor(g.y / cell.y), 2.0) * cell.x * 0.5;
        vec2 f = mod(g, cell) - 0.5 * cell;
        float dia = abs(f.x) + abs(f.y);
        c *= dia < 1.5 ? 0.962 : 1.0;
        // Soft daylight from above, darker towards the corners.
        c *= 0.95 + 0.07 * smoothstep(0.0, 1.0, uv.y) - 0.05 * pow(abs(uv.x - 0.5) * 2.0, 3.0);
        // Contact shade above the skirting.
        c *= 1.0 - 0.08 * exp(-(y - yS) * 120.0);
        return c;
    }
    if (y > yJ) {
        vec3 c = mix(WALL_COLOUR, vec3(0.99, 0.97, 0.93), 0.75);
        float top = floor(yS * iResolution.y / ps);
        float row = top - v.y;
        if (row < 1.0) c *= 1.06;
        else if (row < 2.0) c *= 0.9;
        else if (row < 3.0) c *= 1.02;
        c *= 0.97 + 0.03 * clamp((y - yJ) / (yS - yJ), 0.0, 1.0);
        return c;
    }
    // Floorboards: rows of planks with staggered joints and a little grain.
    float rowH = 5.0;
    float r = floor(v.y / rowH);
    float inRow = mod(v.y, rowH);
    float off = hash11(r * 7.13) * 60.0;
    float plankW = 54.0 + floor(hash11(r * 3.7) * 3.0) * 12.0;
    float pk = floor((v.x + off) / plankW);
    float u = mod(v.x + off, plankW);
    vec3 c = FLOOR_COLOUR * (0.93 + 0.12 * hash12(vec2(pk, r)));
    float grain = hash12(vec2(floor((v.x + off) / 9.0), v.y));
    c *= 0.975 + 0.04 * grain;
    if (inRow < 1.0 || u < 1.0) c *= 0.72;
    else if (inRow > rowH - 1.5) c *= 1.05;
    c *= 0.82 + 0.18 * clamp(y / yJ, 0.0, 1.0);
    // Shadow line under the skirting.
    float top = floor(yJ * iResolution.y / ps);
    if (top - v.y < 1.5) c *= 0.7;
    return c;
}

// ------------------------------------------------------------- furniture

// Food bowl at sprite-pixel offset q from its bottom centre. kib 0..1.
int bowlPix(ivec2 q, float kib)
{
    int x = q.x;
    int y = q.y;
    if (y >= 0 && y <= 5) {
        int hw = 6 + y / 2;
        if (x < -hw || x >= hw) return 0;
        if (y == 0 || y == 5 || x == -hw || x == hw - 1) return 1;
        if (y == 4) return 2;
        if (y == 2 && (x == -2 || x == 1)) return 2;
        return 11;
    }
    if (kib > 0.0 && y >= 6 && y <= 8) {
        int k = y - 6;
        float h = 3.0 * kib;
        if (float(k) >= h) return 0;
        int hw = 6 - k * 2;
        if (x < -hw || x >= hw) return 0;
        return ((x + y) & 1) == 0 ? 13 : 8;
    }
    return 0;
}

// Wicker cat bed: a tub under an elliptical rim seen from slightly above.
// 0 none, 1 back rim, 2 cushion, 3 front rim, 4 tub; q = sprite pixels from
// the bottom centre.
int basketCell(ivec2 q)
{
    vec2 p = vec2(q) + 0.5;
    if (p.y < 0.0 || p.y > 18.0 || abs(p.x) > 21.0) return 0;
    vec2 e = vec2(p.x / 20.5, (p.y - 12.0) / 4.4);
    float eo = dot(e, e);
    vec2 f = vec2(p.x / 16.5, (p.y - 12.6) / 2.6);
    float ei = dot(f, f);
    if (eo < 1.0) {
        if (ei < 1.0) return 2;
        return p.y >= 12.0 ? 1 : 3;
    }
    float hw = 20.5 - max(2.5 - p.y, 0.0) * 1.2;
    if (p.y < 12.0 && abs(p.x) < hw) return 4;
    return 0;
}

// Basket colour index for the back (behind the cat) or front layer;
// negative = that colour in shade.
int basketPix(ivec2 q, bool front)
{
    int c = basketCell(q);
    bool mine = front ? (c == 3 || c == 4) : (c == 1 || c == 2);
    if (!mine) {
        if (c != 0) return 0;
        // Outline round the layer's own cells.
        for (int k = 0; k < 4; k++) {
            ivec2 d = k == 0 ? ivec2(1, 0) : (k == 1 ? ivec2(-1, 0) : (k == 2 ? ivec2(0, 1) : ivec2(0, -1)));
            int n = basketCell(q + d);
            if (front ? (n == 3 || n == 4) : (n == 1 || n == 2)) return 1;
        }
        return 0;
    }
    int x = q.x;
    int y = q.y;
    if (c == 2) {
        // Cushion, shaded towards the back rim; its rim edge is a dark line.
        if (basketCell(q + ivec2(0, 1)) == 1) return 1;
        return y >= 13 ? -14 : 14;
    }
    if (c == 1 || c == 3) {
        if (c == 3 && basketCell(q + ivec2(0, 1)) == 2) return 10;
        if (c == 3 && basketCell(q - ivec2(0, 1)) == 4) return 10;
        return ((x + y * 2 + 64) % 4) < 2 ? 9 : 10;
    }
    // Tub: woven bands with staggered stakes.
    if (basketCell(q + ivec2(0, 1)) == 3) return 1;
    int band = y / 3;
    if (y % 3 == 0) return 10;
    return ((x + (band & 1) * 2 + 64) / 4) % 2 == 0 ? 9 : 10;
}

// Floor lamp at sprite-pixel offset q from its foot; 7 = lit shade.
int lampPix(ivec2 q, bool lit)
{
    int x = q.x;
    int y = q.y;
    if (y >= 0 && y <= 2) {
        int hw = y == 2 ? 3 : 5;
        if (x < -hw || x >= hw) return 0;
        return y == 0 || x == -hw || x == hw - 1 || y == 2 ? 1 : 15;
    }
    if (y > 2 && y < 40) return (x == -1 || x == 0) ? (x == 0 ? 15 : 1) : 0;
    if (y >= 40 && y <= 51) {
        int hw = 9 - (y - 40) / 3;
        if (x < -hw || x >= hw) return 0;
        if (y == 40 || y == 51 || x == -hw || x == hw - 1) return 1;
        return lit ? 7 : (y == 41 ? 3 : 2);
    }
    return 0;
}

// ------------------------------------------------------------- effects

// Pixel puff of radius r at sprite-pixel offset q.
float puff(vec2 q, float r)
{
    return length(q + 0.5) < r ? 1.0 : 0.0;
}

// Head of the cat above its feet, sprite pixels, facing right.
vec2 headOf(int f)
{
    if (f <= F_YAWN || f == F_WASH1 || f == F_WASH2) return vec2(0.0, 27.0);
    if (f == F_LOAF) return vec2(0.0, 21.0);
    if (f == F_SLEEP1 || f == F_SLEEP2) return vec2(5.0, 16.0);
    return vec2(7.0, 23.0);
}

float nightAmount()
{
    if (!NIGHT_BASKET) return 0.0;
    float h = clockHours();
    float a = smoothstep(BEDTIME - 0.5, BEDTIME, h);
    float b = 1.0 - smoothstep(WAKE_UP, WAKE_UP + 0.5, h);
    return max(a, b);
}

void mainImage(out vec4 fragColor, in vec2 fragCoord)
{
    vec2 res = iResolution.xy;
    float A = res.x / res.y;
    vec2 fc = fragCoord;
    float ps = max(1.0, floor(min(res.x, res.y) * CAT_SIZE / 340.0 + 0.5));   // screen px per sprite px
    bool haveState = iChannelResolution[0].x >= float(NSTATE) && iFrame > 0;

    vec3 col = iChannelResolution[1].x > 0.0 ? coverImage(fc) : room(fc, ps);
    bool emissive = false;

    gGridA = haveState ? iChannelResolution[0].x / iChannelResolution[0].y : A;
    gK = A / gGridA;
    vec4 sCat = haveState ? stp(T_CAT) : vec4(0.38 * A, FLOOR_Y, 0.0, 0.0);
    vec4 sMode = haveState ? st(T_MODE) : vec4(0.0, 0.0, 1.0, 0.0);
    vec4 sAnim = haveState ? st(T_ANIM) : vec4(0.0);
    vec4 sGoal = haveState ? st(T_GOAL) : vec4(0.0);
    vec4 sClock = haveState ? st(T_CLOCK) : vec4(0.0);
    vec4 sAux = haveState ? st(T_AUX) : vec4(FLOOR_Y, 0.0, 0.0, 0.0);
    int mode = int(sMode.x + 0.5);
    float facing = sMode.z < 0.0 ? -1.0 : 1.0;
    int frame = clamp(int(sAnim.x + 0.5), 0, 31);
    gEye = clamp(int(sAnim.y + 0.5), 0, 5);
    float night = nightAmount();
    bool inBasket = mode == M_SLEEP && int(sGoal.z + 0.5) == G_BASKET && abs(sCat.x - basketX(gGridA) * gK) < 0.03;

    // ---- furniture, on soft contact shadows
    {
        float y = fc.y / res.y - FLOOR_Y;
        float sw = 0.0;
        if (NIGHT_BASKET) {
            sw += exp(-pow((fc.x / res.y - basketX(gGridA) * gK) / (22.0 * ps / res.y), 6.0));
            sw += 0.6 * exp(-pow((fc.x / res.y - lampX(gGridA) * gK) / (7.0 * ps / res.y), 6.0));
        }
        if (MEALTIMES) sw += 0.8 * exp(-pow((fc.x / res.y - bowlX(gGridA) * gK) / (9.0 * ps / res.y), 6.0));
        col *= 1.0 - 0.18 * min(sw, 1.0) * exp(-pow(y / (2.0 * ps / res.y), 2.0));
    }
    if (NIGHT_BASKET) {
        vec2 b = floor(vec2(basketX(gGridA) * gK, FLOOR_Y) * res.y + 0.5);
        ivec2 q = ivec2(floor((fc - b) / ps));
        int k = basketPix(q, false);
        if (!inBasket) {
            int kf = basketPix(q, true);
            if (kf != 0) k = kf;
        }
        if (k != 0) col = PPAL[abs(k)] * (k < 0 ? 0.82 : 1.0);
        vec2 lb = floor(vec2(lampX(gGridA) * gK, FLOOR_Y) * res.y + 0.5);
        ivec2 lq = ivec2(floor((fc - lb) / ps));
        int lk = lampPix(lq, night > 0.5);
        if (lk > 0) {
            col = PPAL[lk];
            if (lk == 7) {
                col = vec3(1.0, 0.86, 0.55) * (1.0 + 0.2 * float(lq.y > 44));
                emissive = true;
            }
        }
    }
    if (MEALTIMES) {
        vec2 b = floor(vec2(bowlX(gGridA) * gK, FLOOR_Y) * res.y + 0.5);
        ivec2 q = ivec2(floor((fc - b) / ps));
        int k = bowlPix(q, sClock.w);
        if (k > 0) col = PPAL[k];
    }

    // ---- shadow under the cat
    {
        float lift = max(sCat.y - sAux.x, 0.0);
        float w = 10.0 * (1.0 - min(lift * 2.5, 0.6));
        vec2 c = floor(vec2(sCat.x, sAux.x) * res.y + 0.5);
        vec2 q = floor((fc - c) / ps) + 0.5;
        float e = (q.x * q.x) / (w * w) + (q.y * q.y) / 4.0;
        if (e < 1.0 && !inBasket) col *= 1.0 - 0.22 * (1.0 - min(lift * 3.0, 0.7));
    }

    // ---- the object and its shards
    if (haveState) {
        vec4 o = stp(T_OBJ);
        vec4 o2 = st(T_OBJ2);
        int kind = int(o2.x + 0.5);
        if (kind != O_NONE) {
            int stage = int(o2.y + 0.5);
            float a = stage == 0 ? smoothstep(0.0, 0.5, o2.z) * (1.0 - smoothstep(85.0, 90.0, o2.z))
                    : (stage == 2 ? 1.0 - smoothstep(6.0, 8.0, o2.z) : 1.0);
            int k = kind == O_MUG ? P_MUG : P_PENCIL;
            vec2 b = floor(o.xy * res.y + 0.5);
            if (length(fc - b) < 20.0 * ps) {
                int pi = propAt(k, fc, b, ps, o2.w, kind == O_MUG && o.x < 0.5 * A);
                if (pi > 0) col = mix(col, PPAL[pi], a);
            }
        }
        vec4 sh = st(T_SHARD);
        sh.x *= gK;
        if (sh.z >= 0.0) {
            float t = sh.z;
            float a = 1.0 - smoothstep(6.5, 8.5, t);
            for (int i = 0; i < 3; i++) {
                vec2 v0 = i == 0 ? vec2(-0.16, 0.36) : (i == 1 ? vec2(0.19, 0.42) : vec2(0.04, 0.55));
                v0 *= sqrt(CAT_SIZE);
                float tl = 2.0 * v0.y / GRAVITY;
                float tt = min(t, tl);
                vec2 p = sh.xy + v0 * tt + vec2(0.0, -0.5 * GRAVITY * tt * tt);
                p.x += v0.x * 0.15 * (1.0 - exp(-3.0 * max(t - tl, 0.0)));
                p.y = max(p.y, sh.y);
                float rot = (i == 1 ? -9.0 : 7.0) * tt;
                vec2 b = floor(p * res.y + 0.5);
                if (length(fc - b) < 8.0 * ps) {
                    int pi = propAt(P_SHARD1 + i, fc, b, ps, rot, false);
                    if (pi > 0) col = mix(col, PPAL[pi], a);
                }
            }
            // Crash: a puff and a burst of short strokes.
            if (t < 0.4) {
                vec2 c = floor(sh.xy * res.y + 0.5);
                vec2 q = floor((fc - c) / ps) + 0.5;
                float s = 4.0 + t * 30.0;
                float m = puff(q - vec2(-s, 2.0), 3.0 - t * 6.0) + puff(q - vec2(s, 2.0), 3.0 - t * 6.0);
                col = mix(col, vec3(0.98, 0.96, 0.92), min(m, 1.0) * 0.8 * (1.0 - t / 0.4));
                float r = length(q - vec2(0.0, 3.0));
                float an = atan(q.y - 3.0, q.x);
                float ray = abs(fract(an / 6.2831853 * 7.0 + 0.25) - 0.5);
                float r0 = 6.0 + t * 25.0;
                if (q.y > 0.0 && r > r0 && r < r0 + 3.0 && ray < 0.07) col = mix(col, PPAL[1], 1.0 - t / 0.4);
            }
        }
    }

    // ---- the cat
    {
        vec2 P = floor(sCat.xy * res.y + 0.5);
        if (inBasket) P.y += 6.0 * ps;
        vec2 l = (fc - P) / ps + vec2(16.0, 0.0);
        float roll = sAnim.z;
        // Leaps tilt with the flight path.
        if (mode == M_AIR && roll == 0.0) roll = clamp(atan(sCat.w, max(abs(sCat.z), 0.35)) * 0.55, -0.55, 0.6);
        if (abs(l.x - 16.0) < 24.0 && l.y > -10.0 && l.y < 42.0) {
            if (roll != 0.0) {
                vec2 c = vec2(16.0, 16.0);
                float cs = cos(roll * facing);
                float sn = sin(roll * facing);
                vec2 r = l - c;
                l = c + vec2(cs * r.x + sn * r.y, -sn * r.x + cs * r.y);
            }
            ivec2 q = ivec2(floor(l));
            if (facing < 0.0) q.x = 31 - q.x;
            q.y = 31 - q.y;
            int pi = catPix(frame, q);
            if (pi > 0) col = coatColour(pi, q.x);
        }
    }

    if (inBasket) {
        vec2 b = floor(vec2(basketX(gGridA) * gK, FLOOR_Y) * res.y + 0.5);
        ivec2 q = ivec2(floor((fc - b) / ps));
        int k = basketPix(q, true);
        if (k != 0) col = PPAL[abs(k)] * (k < 0 ? 0.82 : 1.0);
    }

    // ---- yarn ball
    if (haveState) {
        vec4 y1 = stp(T_YARN);
        vec4 y2 = st(T_YARN2);
        if (y2.x > 0.0) {
            vec2 c = floor(y1.xy * res.y + 0.5);
            vec2 q = floor((fc - c) / ps) + 0.5;
            float d = length(q);
            float a = smoothstep(0.0, 0.08, y2.x) * (1.0 - smoothstep(66.0, 70.0, y2.z));
            if (d < YARN_R + 1.0) {
                vec3 yc;
                if (d > YARN_R) {
                    yc = PPAL[1];
                } else {
                    float an = y2.y;
                    vec2 r = vec2(cos(an) * q.x - sin(an) * q.y, sin(an) * q.x + cos(an) * q.y);
                    float band = floor((r.x + 0.6 * sin(r.y * 0.9)) / 1.8);
                    yc = mod(band, 2.0) < 1.0 ? PPAL[4] : PPAL[5];
                    if (abs(r.y - 0.4 * r.x) < 0.6 && d < YARN_R - 1.0) yc = PPAL[6];
                    if (q.x < -1.0 && q.y > 1.0 && d > YARN_R - 1.6) yc = mix(yc, PPAL[6], 0.6);
                }
                col = mix(col, yc, a);
            }
            // Loose end on the ground behind the ball.
            vec2 t = q - vec2(0.0, -YARN_R + 0.5);
            float tail = sign(y1.z + 1e-3);
            float u = -t.x * tail;
            if (u > 3.0 && u < 10.0 && abs(t.y - floor(0.6 * sin(u * 0.9))) < 0.5) col = mix(col, PPAL[4], a);
        }
    }

    // ---- night light: the room dims and the lamp glows
    if (night > 0.0 && !emissive) {
        vec2 lp = vec2(lampX(gGridA) * gK, FLOOR_Y + 46.0 * ps / res.y);
        vec2 d = fc / res.y - lp;
        d.y *= 1.4;
        float g = exp(-dot(d, d) / 0.035) + 0.35 * exp(-dot(d, d) / 0.25);
        vec3 light = vec3(0.40, 0.42, 0.55) + vec3(0.92, 0.68, 0.40) * g;
        col *= mix(vec3(1.0), light, night);
    }

    // ---- effects above the cat
    if (haveState) {
        vec2 h = headOf(frame);
        h.x *= facing;
        vec2 head = floor(sCat.xy * res.y + 0.5) + h * ps + (inBasket ? vec2(0.0, 6.0 * ps) : vec2(0.0));
        vec4 fx = st(T_FX);
        vec4 inp = st(T_INPUT);
        float dim = mix(1.0, 0.8, night);
        // Hearts.
        float hc = fx.x;
        bool emitting = fx.y < 0.0;
        if (emitting || hc - fx.y < 2.0) {
            for (int k = 0; k < 3; k++) {
                float n = floor(hc / 0.7) - float(k);
                float birth = n * 0.7;
                if (n < 0.0 || (!emitting && birth > fx.y)) continue;
                float age = hc - birth;
                if (age > 1.9) continue;
                float side = mod(n, 2.0) < 1.0 ? -1.0 : 1.0;
                vec2 o = vec2(side * (5.0 + 6.0 * hash11(n * 1.7)) + sin(age * 3.0 + n) * 2.0, 2.0 + age * 14.0);
                vec2 b = head + floor(o) * ps;
                int pi = propAt(P_HEART, fc, b, ps, 0.0, false);
                float a = smoothstep(0.0, 0.12, age) * (1.0 - smoothstep(1.3, 1.9, age));
                if (pi > 0) col = mix(col, PPAL[pi] * dim, a);
            }
        }
        // Zzz.
        if (mode == M_SLEEP) {
            for (int k = 0; k < 3; k++) {
                float t = fract(sMode.y / 2.6 + float(k) / 3.0);
                vec2 o = vec2(facing * (4.0 + t * 9.0) + sin(t * 7.0) * 1.5, 5.0 + t * 16.0);
                vec2 b = head + floor(o) * ps;
                int pi = propAt(P_Z, fc, b, ps, 0.0, false);
                float a = smoothstep(0.0, 0.12, t) * (1.0 - smoothstep(0.7, 1.0, t)) * smoothstep(0.5, 1.5, sMode.y);
                if (pi > 0) col = mix(col, PPAL[pi] * dim, a * 0.9);
            }
        }
        // Meow bubble.
        float bt = fx.z;
        if (bt < 1.5) {
            vec2 b = head + vec2(13.0, 6.0 + 2.0 * (1.0 - smoothstep(0.0, 0.12, bt))) * ps;
            int k = fx.w > 0.5 ? P_BUBBLE_HEART : P_BUBBLE_MEOW;
            float a = smoothstep(0.0, 0.05, bt) * (1.0 - smoothstep(1.2, 1.5, bt));
            int pi = propAt(k, fc, b, ps, 0.0, false);
            if (pi > 0) col = mix(col, PPAL[pi] * dim, a);
        }
        // Startled "!".
        float et = inp.w;
        if (et < 0.9) {
            vec2 b = head + vec2(facing * 3.0, 7.0 + floor(3.0 * sin(min(et * 9.0, 3.14159)))) * ps;
            int pi = propAt(P_EXCL, fc, b, ps, 0.0, false);
            if (pi > 0) col = mix(col, PPAL[pi], 1.0 - smoothstep(0.7, 0.9, et));
        }
        // Landing dust.
        vec4 ld = st(T_LAND);
        ld.z *= gK;
        if (ld.x < 0.4 && ld.y > 0.5) {
            vec2 c = floor(ld.zw * res.y + 0.5);
            vec2 q = floor((fc - c) / ps);
            float t = ld.x / 0.4;
            float s = 7.0 + t * 9.0;
            float r = (2.0 + min(ld.y, 2.0)) * (1.0 - t);
            float m = puff(q - vec2(-s, 1.0 + t * 3.0), r) + puff(q - vec2(s, 1.0 + t * 3.0), r);
            col = mix(col, vec3(0.98, 0.96, 0.92) * dim, min(m, 1.0) * 0.75 * (1.0 - t));
        }
    }

    fragColor = vec4(col, 1.0);
}
